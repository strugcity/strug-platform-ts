#!/usr/bin/env sh
# Universal QA pre-push hook — generated by strug-standards/scripts/sync-hooks.js
# DO NOT EDIT MANUALLY — changes will be overwritten on next sync.
# Project: Strug Platform TS
# Stack: typescript

set -e

REMOTE="$1"
REMOTE_URL="$2"

while read local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue  # Branch deletion
  fi

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    BASE=$(git merge-base HEAD origin/main 2>/dev/null || echo "")
    if [ -z "$BASE" ]; then
      RANGE="HEAD"
    else
      RANGE="$BASE..$local_sha"
    fi
  else
    RANGE="$remote_sha..$local_sha"
  fi

  CHANGED=$(git diff --name-only "$RANGE" 2>/dev/null || true)


  # ── Frontend lint ──────────────────────────────────────────────
  FRONTEND_FILES=$(echo "$CHANGED" | grep -E '\.(ts|tsx|js|jsx)$' || true)
  if [ -n "$FRONTEND_FILES" ]; then
    echo "🔍 Running frontend lint..."
    if ! npm run lint; then
      echo ""
      echo "❌ Pre-push aborted: lint errors detected."
      echo "   Run 'npm run lint' to see the full error list, fix them, then push again."
      exit 1
    fi
    echo "✅ Frontend lint OK"
  fi

  # ── Visual verification gate ────────────────────────────────────
  if [ -n "$FRONTEND_FILES" ]; then
    VERIFIED_MARKER=".last-verified"
    echo ""
    echo "  📱 Frontend changes detected — checking visual verification..."

    if [ ! -f "$VERIFIED_MARKER" ]; then
      echo ""
      echo "  ✗ BLOCKED: visual verification required before pushing frontend changes."
      echo ""
      echo "  You must:"
      echo "    1. Start the dev server and verify every affected screen"
      echo "    2. Write the marker: node -e \"require('fs').writeFileSync('.last-verified', Date.now().toString())\""
      echo ""
      echo "  Then push again."
      echo ""
      exit 1
    fi

    MARKER_TIME=$(node -e "try{process.stdout.write(require('fs').readFileSync('$VERIFIED_MARKER','utf8').trim())}catch(e){process.stdout.write('0')}" 2>/dev/null || echo "0")
    OLDEST_COMMIT_TIME=$(git log --format="%ct000" "$RANGE" 2>/dev/null | tail -1 || echo "0")

    if [ -n "$OLDEST_COMMIT_TIME" ] && [ "$MARKER_TIME" -lt "$OLDEST_COMMIT_TIME" ]; then
      echo ""
      echo "  ✗ BLOCKED: verification marker is older than the commits being pushed."
      echo "  Re-verify after your final code change, then push again."
      echo ""
      exit 1
    fi

    echo "  ✓ Visual verification confirmed"
    echo ""
  fi

done

exit 0
