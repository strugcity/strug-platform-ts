#!/usr/bin/env sh
# Pre-commit hook — generated by strug-standards/scripts/sync-hooks.js
# DO NOT EDIT MANUALLY — changes will be overwritten on next sync.
# Project: Strug Platform TS

set -e

# ── Branch display and drift detection ──────────────────────────────────────
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null) || true

if [ -z "$CURRENT_BRANCH" ]; then
  echo ""
  echo "  ✗ BLOCKED: repository is in detached HEAD state."
  echo "  Checkout a named branch before committing:"
  echo "    git checkout -b <branch-name>"
  echo ""
  exit 1
fi

echo ""
echo "  📌 Current branch: $CURRENT_BRANCH"

# If a session branch was recorded at session start, check for drift
SESSION_BRANCH_FILE=".claude/session-branch"
if [ -f "$SESSION_BRANCH_FILE" ]; then
  SESSION_BRANCH=$(cat "$SESSION_BRANCH_FILE" | tr -d '[:space:]')
  if [ -f "$SESSION_BRANCH_FILE" ] && [ -z "$SESSION_BRANCH" ]; then
    echo "[pre-commit] WARNING: session-branch file is empty — branch drift check skipped." >&2
  fi
  if [ -n "$SESSION_BRANCH" ] && [ "$SESSION_BRANCH" != "$CURRENT_BRANCH" ]; then
    echo ""
    echo "  ✗ BLOCKED: branch mismatch detected."
    echo ""
    echo "  Session started on:  $SESSION_BRANCH"
    echo "  Currently on:        $CURRENT_BRANCH"
    echo ""
    echo "  You switched branches mid-task. This commit would land on the wrong branch."
    echo "  Switch back to '$SESSION_BRANCH' before committing."
    echo ""
    exit 1
  fi
fi

# ── Guard: block direct commits to main ─────────────────────────────────────
if [ "$CURRENT_BRANCH" = "main" ]; then
  # Exemption: strug-standards machinery is machine-generated — committing a
  # re-sync to main is routine maintenance, not the feature/research work this
  # guard targets. Allow the commit IFF every staged path is sync output.
  # Anything else (mixed commit, source files, or an empty commit) is still
  # blocked.
  #
  # "Sync output" is what the GENERATOR says it writes, not a directory prefix.
  # The two lists below are rendered into this file by sync-hooks.js from the
  # same code that writes the files (syncOutputPaths), so a file the generator
  # does not write cannot be exempt. A prefix also waved through everything
  # hand-written beside the generated files: dreamTeam tracks
  # .claude/hooks/session-start.sh and .claude/mcp.json, both executable, under
  # .claude/ (SCE-3838).
  #
  #   hook paths   (.githooks/pre-commit, .githooks/pre-push) — by path AND by
  #                staged content: the generator header, see below.
  #   claude paths (.claude/settings.json, .claude/commands/<synced name>) — by
  #                path. They are JSON/markdown with no header to check. KNOWN
  #                RESIDUAL: settings.json is merged into the repo's own file,
  #                so a hand edit to it still commits to main unreviewed.
  #   .github/workflows/<file> — written by sync-ci.js; by path AND content.
  #
  # Workflows are scoped to .github/workflows/, deliberately not .github/.
  # CODEOWNERS, issue templates and dependabot config sit beside it and are
  # hand-written policy — precisely what this guard should keep routing through
  # review.
  #
  # "By content" means the STAGED blob has a "# DO NOT EDIT MANUALLY" comment in
  # its first 5 lines AND is not opted out with a line starting
  # "# MANAGED-EXTERNALLY" (sync-ci.js stops writing a file so marked, so every
  # later change to it is a hand edit — the header stays behind below the marker).
  # sync-ci.js reads the marker after trimStart(), which strips a BOM and leading
  # whitespace, so this does too. The marker pattern is anchored to a line start
  # because the generated qa-gate header itself mentions it on line 3. That stops
  # hand-written files being committed here by accident; it is not a defence
  # against someone who copies the header in. A deletion has no staged content,
  # so it is not exempt either.
  #
  # --no-renames: without it a staged rename lists only its NEW path, hiding the
  # deletion of the old one (git mv src/app.js .githooks/app.js looked exempt).
  #
  # Fail closed: every test below is a POSITIVE proof that a path is sync output,
  # and a path that is not proven is listed. So a grep/git that errors can only
  # add to NON_SYNC. There is deliberately no first-stage `grep -v` feeding the
  # loop — its failure would be swallowed by `|| true`, leave NON_SYNC empty, and
  # wave the commit through (SCE-2762's principle: a guard that cannot read its
  # input must block, not shrug). The `|| true` only absorbs the loop's own exit
  # status, which is that of whatever ran last. An unrendered list is the same
  # shape: the placeholder is inside single quotes and matches no path.
  _SYNC_HOOK_PATHS='.githooks/pre-commit .githooks/pre-push'
  _SYNC_CLAUDE_PATHS='.claude/settings.json .claude/commands/design-compare.md .claude/commands/dev-session.md .claude/commands/tdd-pr-audit.md .claude/commands/visual-drift-report.md .claude/commands/visual-verification-pipeline.md .claude/commands/visual-verify-setup.md .claude/commands/visual-verify.md'
  _BOM=$(printf '\357\273\277')

  # _strug_listed PATH "LIST" — is PATH one of the space-separated entries?
  # Whole-line fixed-string match; entries are validated plain paths.
  _strug_listed() {
    [ -n "$1" ] && printf '%s\n' $2 | grep -qxF -- "$1"
  }

  # _strug_generated PATH — does the STAGED blob carry the generator header and
  # not the opt-out marker, within its first 5 lines?
  _strug_generated() {
    _h=$(git show ":$1" 2>/dev/null | head -n 5)
    printf '%s\n' "$_h" | grep -q '^# DO NOT EDIT MANUALLY' \
      && [ "$(printf '%s\n' "$_h" | grep -cE "^(${_BOM})?[[:space:]]*# MANAGED-EXTERNALLY")" = 0 ]
  }

  STAGED=$(git diff --cached --no-renames --name-only)
  NON_SYNC=$(printf '%s\n' "$STAGED" | while IFS= read -r f; do
    if _strug_listed "$f" "$_SYNC_CLAUDE_PATHS"; then
      continue
    fi
    if _strug_listed "$f" "$_SYNC_HOOK_PATHS" \
       || printf '%s\n' "$f" | grep -qE '^\.github/workflows/'; then
      if _strug_generated "$f"; then
        continue
      fi
    fi
    printf '%s\n' "$f"
  done || true)
  if [ -n "$STAGED" ] && [ -z "$NON_SYNC" ]; then
    echo "  ✓ sync-artifact commit (generated hooks / synced .claude files / generated workflows only) — allowed on main."
  else
    echo ""
    echo "  ✗ BLOCKED: direct commits to 'main' are not allowed."
    echo "  (Commits touching only files strug-standards generates — .githooks/"
    echo "   pre-commit and pre-push, .claude/settings.json, synced .claude/commands,"
    echo "   and GENERATED workflows under .github/workflows/ — i.e. a re-sync — are"
    echo "   exempt; this commit touches other paths or hand-written files.)"
    echo ""
    echo "  Create a feature branch first:"
    echo "    git checkout -b feat/<your-branch-name>"
    echo ""
    exit 1
  fi
fi

# ── Guard: block committing machine-local Claude settings ───────────────────
# Applies on every branch, including the .claude/ sync-artifact exemption above.
# >>> guard-parity: settings.local.json — keep byte-identical between
# templates/pre-commit.template and templates/husky-pre-commit-guard.template
# (asserted by tests/husky-guard-injection.audit.test.js) >>>
# .claude/settings.local.json is rewritten per-machine (bypassPermissions) by
# strug-standards/scripts/sync-worktree-settings.js. Committing it produces
# perpetual churn; it must stay gitignored + untracked.
# --diff-filter=d excludes staged DELETIONS, so committing the recommended
# `git rm --cached` remediation below is allowed; only additions/modifications block.
#
# The staged list is captured rather than piped straight into grep: a pipeline's
# exit status is grep's, and `set -e` does not apply inside an `if` condition, so
# a failing `git diff --cached` produced empty output, matched nothing, and let
# the commit through with no message at all. A guard that cannot read the index
# must block rather than shrug (SCE-2762).
if ! _strug_staged=$(git diff --cached --name-only --diff-filter=d); then
  echo ""
  echo "  ✗ BLOCKED: the strug-standards guard could not read the staged file list."
  echo "  'git diff --cached --name-only' failed, so whether"
  echo "  .claude/settings.local.json is staged is unknown — refusing to commit blind."
  echo "  Bypass deliberately with --no-verify if you know the index is fine."
  echo ""
  exit 1
fi
if printf '%s\n' "$_strug_staged" | grep -qx '\.claude/settings\.local\.json'; then
  echo ""
  echo "  ✗ BLOCKED: .claude/settings.local.json is machine-local; do not commit it."
  echo "  Untrack it:  git rm --cached .claude/settings.local.json"
  echo "  See strug-standards/standards/claude-local-artifacts.md"
  echo ""
  exit 1
fi
# <<< end guard-parity <<<
