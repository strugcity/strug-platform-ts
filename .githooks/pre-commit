#!/usr/bin/env sh
# Pre-commit hook — generated by strug-standards/scripts/sync-hooks.js
# DO NOT EDIT MANUALLY — changes will be overwritten on next sync.
# Project: Strug Platform TS

set -e

# ── Branch display and drift detection ──────────────────────────────────────
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null) || true

if [ -z "$CURRENT_BRANCH" ]; then
  echo ""
  echo "  ✗ BLOCKED: repository is in detached HEAD state."
  echo "  Checkout a named branch before committing:"
  echo "    git checkout -b <branch-name>"
  echo ""
  exit 1
fi

echo ""
echo "  📌 Current branch: $CURRENT_BRANCH"

# If a session branch was recorded at session start, check for drift
SESSION_BRANCH_FILE=".claude/session-branch"
if [ -f "$SESSION_BRANCH_FILE" ]; then
  SESSION_BRANCH=$(cat "$SESSION_BRANCH_FILE" | tr -d '[:space:]')
  if [ -f "$SESSION_BRANCH_FILE" ] && [ -z "$SESSION_BRANCH" ]; then
    echo "[pre-commit] WARNING: session-branch file is empty — branch drift check skipped." >&2
  fi
  if [ -n "$SESSION_BRANCH" ] && [ "$SESSION_BRANCH" != "$CURRENT_BRANCH" ]; then
    echo ""
    echo "  ✗ BLOCKED: branch mismatch detected."
    echo ""
    echo "  Session started on:  $SESSION_BRANCH"
    echo "  Currently on:        $CURRENT_BRANCH"
    echo ""
    echo "  You switched branches mid-task. This commit would land on the wrong branch."
    echo "  Switch back to '$SESSION_BRANCH' before committing."
    echo ""
    exit 1
  fi
fi

# ── Guard: block direct commits to main ─────────────────────────────────────
if [ "$CURRENT_BRANCH" = "main" ]; then
  # Exemption: strug-standards machinery (.githooks/, .claude/) is machine-
  # generated by sync-hooks.js — committing a re-sync to main is routine
  # maintenance, not the feature/research work this guard targets. Allow the
  # commit IFF every staged path is under .githooks/ or .claude/. Anything else
  # (mixed commit, source files, or an empty commit) is still blocked.
  STAGED=$(git diff --cached --name-only)
  NON_SYNC=$(printf '%s\n' "$STAGED" | grep -vE '^\.(githooks|claude)/' || true)
  if [ -n "$STAGED" ] && [ -z "$NON_SYNC" ]; then
    echo "  ✓ sync-artifact commit (.githooks/ / .claude/ only) — allowed on main."
  else
    echo ""
    echo "  ✗ BLOCKED: direct commits to 'main' are not allowed."
    echo "  (Commits touching only .githooks/ and .claude/ — i.e. a sync-hooks"
    echo "   re-sync — are exempt; this commit touches other paths.)"
    echo ""
    echo "  Create a feature branch first:"
    echo "    git checkout -b feat/<your-branch-name>"
    echo ""
    exit 1
  fi
fi

# ── Guard: block committing machine-local Claude settings ───────────────────
# .claude/settings.local.json is rewritten per-machine (bypassPermissions) by
# strug-standards/scripts/sync-worktree-settings.js. Committing it produces
# perpetual churn; it must stay gitignored + untracked. Applies on every branch
# (including the .claude/ sync-artifact exemption above).
# --diff-filter=d excludes staged DELETIONS, so committing the recommended
# `git rm --cached` remediation below is allowed; only additions/modifications block.
if git diff --cached --name-only --diff-filter=d | grep -qx '\.claude/settings\.local\.json'; then
  echo ""
  echo "  ✗ BLOCKED: .claude/settings.local.json is machine-local; do not commit it."
  echo "  Untrack it:  git rm --cached .claude/settings.local.json"
  echo "  See strug-standards/standards/claude-local-artifacts.md"
  echo ""
  exit 1
fi
